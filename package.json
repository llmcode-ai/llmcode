{
  "name": "llmcode",
  "displayName": "LLMcode",
  "description": "opencode remastered as a VS Code extension — chat, inline code assistant, and full config control",
  "version": "0.1.0",
  "publisher": "llmcode",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/llmcode-ai/llmcode.git"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Machine Learning",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "llmcode.open", "title": "LLMcode: Open Chat", "icon": "$(comment-discussion)" },
      { "command": "llmcode.newSession", "title": "LLMcode: New Session" },
      { "command": "llmcode.deleteSession", "title": "LLMcode: Delete Session" },
      { "command": "llmcode.importFromMachine", "title": "LLMcode: Import Skills/MCP/Plugins from Machine", "icon": "$(cloud-download)" },
      { "command": "llmcode.checkInstall", "title": "LLMcode: Check opencode Installation" },
      { "command": "llmcode.installOpencode", "title": "LLMcode: Install opencode" },
      { "command": "llmcode.openTerminal", "title": "LLMcode: Open Terminal Session" },
      { "command": "llmcode.toggleAutocomplete", "title": "LLMcode: Toggle Autocomplete" },
      { "command": "llmcode.inlineEdit", "title": "LLMcode: Inline Edit Selection" },
      { "command": "llmcode.explainSelection", "title": "LLMcode: Explain Selection" },
      { "command": "llmcode.fixSelection", "title": "LLMcode: Fix Selection" },
      { "command": "llmcode.refactorSelection", "title": "LLMcode: Refactor Selection" },
      { "command": "llmcode.addFileToChat", "title": "LLMcode: Add File to Chat" }
    ],
    "menus": {
      "view/title": [
        { "command": "llmcode.newSession", "when": "view == llmcode.chat", "group": "navigation" },
        { "command": "llmcode.importFromMachine", "when": "view == llmcode.chat", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "llmcode.inlineEdit", "group": "llmcode" },
        { "command": "llmcode.explainSelection", "group": "llmcode" },
        { "command": "llmcode.fixSelection", "group": "llmcode" },
        { "command": "llmcode.refactorSelection", "group": "llmcode" },
        { "command": "llmcode.addFileToChat", "group": "llmcode" },
        { "command": "llmcode.openTerminal", "group": "llmcode" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llmcode",
          "title": "LLMcode",
          "icon": "media/llmcode.svg"
        }
      ]
    },
    "views": {
      "llmcode": [
        { "id": "llmcode.chat", "name": "Chat", "type": "webview", "contextualTitle": "LLMcode" },
        { "id": "llmcode.sessions", "name": "Sessions", "type": "tree", "contextualTitle": "LLMcode" },
        { "id": "llmcode.providers", "name": "Providers & Models", "type": "tree", "contextualTitle": "LLMcode" },
        { "id": "llmcode.agents", "name": "Agents", "type": "tree", "contextualTitle": "LLMcode" },
        { "id": "llmcode.skills", "name": "Skills", "type": "tree", "contextualTitle": "LLMcode" },
        { "id": "llmcode.mcp", "name": "MCP Servers", "type": "tree", "contextualTitle": "LLMcode" },
        { "id": "llmcode.plugins", "name": "Plugins", "type": "tree", "contextualTitle": "LLMcode" }
      ]
    },
    "configuration": {
      "title": "LLMcode",
      "properties": {
        "llmcode.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable tab autocomplete (ghost text)."
        },
        "llmcode.autocomplete.model": {
          "type": "string",
          "default": "",
          "description": "Model for autocomplete, e.g. anthropic/claude-sonnet. Empty uses the default model."
        },
        "llmcode.mode": {
          "type": "string",
          "enum": ["chat", "assistant", "auto"],
          "default": "auto",
          "description": "Chat mode, inline assistant mode, or auto."
        },
        "llmcode.opencode.command": {
          "type": "string",
          "default": "opencode",
          "description": "Path or name of the opencode executable."
        },
        "llmcode.opencode.port": {
          "type": "number",
          "default": 0,
          "description": "Fixed port for opencode serve (0 = auto)."
        },
        "llmcode.opencode.hostname": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Hostname for opencode serve."
        }
      }
    },
    "keybindings": [
      { "command": "llmcode.open", "key": "ctrl+shift+l" },
      { "command": "llmcode.inlineEdit", "key": "ctrl+k", "when": "editorTextFocus && editorHasSelection" }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "compile-tests": "tsc -p tsconfig.json",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "vscode-test",
    "package": "npm run typecheck && npm run compile && vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.5"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.94.0",
    "@vscode/test-cli": "^0.0.1",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
