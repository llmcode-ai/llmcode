{
  "name": "llmcode",
  "displayName": "LLMcode",
  "description": "opencode remastered as a VS Code extension — chat, inline code assistant, and full config control",
  "version": "0.2.7",
  "publisher": "llmcode",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/llmcode-ai/llmcode.git"
  },
  "homepage": "https://github.com/llmcode-ai/llmcode#readme",
  "bugs": {
    "url": "https://github.com/llmcode-ai/llmcode/issues"
  },
  "keywords": [
    "opencode",
    "ai",
    "chat",
    "assistant",
    "copilot",
    "cursor",
    "autocomplete",
    "code generation",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "galleryBanner": {
    "color": "#0b3d91",
    "theme": "dark"
  },
  "categories": [
    "Machine Learning",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmcode.open",
        "title": "%command.open%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "llmcode.newSession",
        "title": "%command.newSession%"
      },
      {
        "command": "llmcode.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "llmcode.selectChatModel",
        "title": "%command.selectChatModel%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "llmcode.useLocalAgent",
        "title": "%command.useLocalAgent%"
      },
      {
        "command": "llmcode.importFromMachine",
        "title": "%command.importFromMachine%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "llmcode.checkInstall",
        "title": "%command.checkInstall%"
      },
      {
        "command": "llmcode.installOpencode",
        "title": "%command.installOpencode%"
      },
      {
        "command": "llmcode.openTerminal",
        "title": "%command.openTerminal%"
      },
      {
        "command": "llmcode.toggleAutocomplete",
        "title": "%command.toggleAutocomplete%"
      },
      {
        "command": "llmcode.inlineEdit",
        "title": "%command.inlineEdit%"
      },
      {
        "command": "llmcode.explainSelection",
        "title": "%command.explainSelection%"
      },
      {
        "command": "llmcode.fixSelection",
        "title": "%command.fixSelection%"
      },
      {
        "command": "llmcode.refactorSelection",
        "title": "%command.refactorSelection%"
      },
      {
        "command": "llmcode.addFileToChat",
        "title": "%command.addFileToChat%"
      },
      {
        "command": "llmcode.showLastModel",
        "title": "%command.showLastModel%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "llmcode.inlineEdit",
          "group": "llmcode"
        },
        {
          "command": "llmcode.explainSelection",
          "group": "llmcode"
        },
        {
          "command": "llmcode.fixSelection",
          "group": "llmcode"
        },
        {
          "command": "llmcode.refactorSelection",
          "group": "llmcode"
        },
        {
          "command": "llmcode.addFileToChat",
          "group": "llmcode"
        },
        {
          "command": "llmcode.openTerminal",
          "group": "llmcode"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "llmcode.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.autocomplete.enabled%"
        },
        "llmcode.autocomplete.model": {
          "type": "string",
          "default": "",
          "description": "%config.autocomplete.model%"
        },
        "llmcode.mode": {
          "type": "string",
          "enum": [
            "chat",
            "assistant",
            "auto"
          ],
          "default": "auto",
          "description": "%config.mode%"
        },
        "llmcode.opencode.command": {
          "type": "string",
          "default": "opencode",
          "description": "%config.opencode.command%"
        },
        "llmcode.opencode.port": {
          "type": "number",
          "default": 0,
          "description": "%config.opencode.port%"
        },
        "llmcode.opencode.hostname": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "%config.opencode.hostname%"
        },
        "llmcode.setDefaultChatModel": {
          "type": "boolean",
          "default": true,
          "description": "%config.setDefaultChatModel%"
        }
      }
    },
    "keybindings": [
      {
        "command": "llmcode.open",
        "key": "ctrl+shift+l"
      },
      {
        "command": "llmcode.inlineEdit",
        "key": "ctrl+k",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "llmcode",
        "displayName": "LLMcode (opencode)"
      }
    ],
    "chatParticipants": [
      {
        "id": "llmcode.agent",
        "name": "llmcode",
        "fullName": "LLMcode (opencode)",
        "description": "%chatParticipant.description%",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "compile-tests": "tsc -p tsconfig.json",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "vscode-test",
    "package": "npm run typecheck && npm run compile && vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.5"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.94.0",
    "@vscode/test-cli": "^0.0.1",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "l10n": "./l10n"
}
